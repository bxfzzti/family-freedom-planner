{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Family Freedom Planner Workflow Input v1.4",
  "type": "object",
  "required": ["user_text"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "user_text": {"type": "string", "minLength": 1},
    "selected_topics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"enum": ["GENERAL", "HOUSING_EXISTING", "HOUSING_FIRST_BUY", "EDUCATION", "CAREER", "SPOUSE_BREAK", "FINANCING", "PARENT_CARE", "RELOCATION", "INVESTING"]}
    },
    "requires_external_facts": {"type": "boolean"},
    "family_state": {"$ref": "family-state.schema.json"}
  },
  "additionalProperties": false
}
