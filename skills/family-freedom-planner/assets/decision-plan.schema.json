{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "horizon_months": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1200
    },
    "protected_reserve": {
      "type": "number",
      "minimum": 0
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "BUDGET",
              "HOME_PURCHASE",
              "REFINANCE"
            ]
          },
          "loans": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "loan_id": {
                  "type": "string",
                  "minLength": 1
                },
                "principal": {
                  "type": "number",
                  "minimum": 0
                },
                "annual_rate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "years": {
                  "type": "number",
                  "minimum": 0.08333333333333333,
                  "maximum": 100
                }
              },
              "required": [
                "loan_id",
                "principal",
                "annual_rate",
                "years"
              ],
              "additionalProperties": false
            }
          },
          "spending_delta_annual": {
            "type": "number"
          },
          "target_home_price": {
            "type": "number",
            "minimum": 0
          },
          "down_payment": {
            "type": "number",
            "minimum": 0
          },
          "transaction_costs": {
            "type": "number",
            "minimum": 0
          },
          "renovation_costs": {
            "type": "number",
            "minimum": 0
          },
          "moving_costs": {
            "type": "number",
            "minimum": 0
          },
          "sale": {
            "type": "object",
            "properties": {
              "home_id": {
                "type": "string",
                "minLength": 1
              },
              "sale_price": {
                "type": "number",
                "minimum": 0
              },
              "transaction_costs": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "home_id",
              "sale_price",
              "transaction_costs"
            ],
            "additionalProperties": false
          },
          "debt_id": {
            "type": "string",
            "minLength": 1
          },
          "confirmed_refinance_amount": {
            "type": "number",
            "minimum": 0
          },
          "annual_payment_after_refinance": {
            "type": "number",
            "minimum": 0
          },
          "due_month": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1200
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "loans",
          "spending_delta_annual"
        ]
      }
    },
    "scenarios": {
      "type": "object",
      "properties": {
        "NORMAL": {
          "type": "object",
          "properties": {
            "income_overrides": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0
              }
            },
            "spending_delta_annual": {
              "type": "number"
            },
            "changes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "month": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1200
                  },
                  "income_overrides": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "spending_delta_annual": {
                    "type": "number"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "month"
                ]
              }
            },
            "one_off_expenses": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "month": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1200
                  },
                  "amount": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "month",
                  "amount"
                ],
                "additionalProperties": false
              }
            },
            "refinance_overrides": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0
              }
            },
            "assumptions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "income_overrides",
            "spending_delta_annual",
            "changes",
            "one_off_expenses",
            "refinance_overrides",
            "assumptions"
          ],
          "additionalProperties": false
        },
        "STRESS": {
          "type": "object",
          "properties": {
            "income_overrides": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0
              }
            },
            "spending_delta_annual": {
              "type": "number"
            },
            "changes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "month": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1200
                  },
                  "income_overrides": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "spending_delta_annual": {
                    "type": "number"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "month"
                ]
              }
            },
            "one_off_expenses": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "month": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1200
                  },
                  "amount": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "month",
                  "amount"
                ],
                "additionalProperties": false
              }
            },
            "refinance_overrides": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0
              }
            },
            "assumptions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "income_overrides",
            "spending_delta_annual",
            "changes",
            "one_off_expenses",
            "refinance_overrides",
            "assumptions"
          ],
          "additionalProperties": false
        },
        "SEVERE": {
          "type": "object",
          "properties": {
            "income_overrides": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0
              }
            },
            "spending_delta_annual": {
              "type": "number"
            },
            "changes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "month": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1200
                  },
                  "income_overrides": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "spending_delta_annual": {
                    "type": "number"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "month"
                ]
              }
            },
            "one_off_expenses": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "month": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1200
                  },
                  "amount": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "month",
                  "amount"
                ],
                "additionalProperties": false
              }
            },
            "refinance_overrides": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0
              }
            },
            "assumptions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "income_overrides",
            "spending_delta_annual",
            "changes",
            "one_off_expenses",
            "refinance_overrides",
            "assumptions"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "NORMAL",
        "STRESS",
        "SEVERE"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "horizon_months",
    "protected_reserve",
    "options",
    "scenarios"
  ],
  "additionalProperties": false
}
